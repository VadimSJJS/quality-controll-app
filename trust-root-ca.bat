@echo off
rem ============================================================================
rem  Quality Control App - ????????? ??????????? ????????? ??????????? (root CA)
rem  ? "?????????? ???????? ?????? ????????????".
rem
rem  ?????, ????? https://devteam7:8082/ ?????????? ? Chrome/Edge ???
rem  ?????????????? "??????????? ?? ????????". ?????? ?????? ?????????? ???? ???
rem  ?? ?????? ?? (??? ???????? ??? ????????? ????????? - ??. HTTPS-SETUP.md).
rem
rem  ?????????????:
rem    trust-root-ca.bat                - ?????????? root-ca.crt ?? ???? ????? (????? ????? ??????)
rem    trust-root-ca.bat D:\path\root-ca.crt
rem    trust-root-ca.bat /check         - ?????? ????????, ?????????? ?? ??????????
rem ============================================================================
setlocal
set "CERT_FILE=%~dp0root-ca.crt"
if defined QC_ROOT_CA set "CERT_FILE=%QC_ROOT_CA%"
if /I "%~1"=="/check" goto :check
if not "%~1"=="" set "CERT_FILE=%~1"

if not exist "%CERT_FILE%" (
    echo [ERROR] Certificate file not found: %CERT_FILE%
    echo [ERROR] Usage: trust-root-ca.bat ^<path-to-root-ca.crt^>
    pause
    exit /b 1
)

net session >nul 2>&1
if errorlevel 1 (
    echo [INFO] Administrator rights are required. Confirm the UAC prompt...
    powershell -NoProfile -Command "$env:QC_ROOT_CA='%CERT_FILE%'; Start-Process -FilePath '%~f0' -Verb RunAs"
    exit /b
)

echo [INFO] Installing certificate: %CERT_FILE%
certutil -addstore -f Root "%CERT_FILE%"
if errorlevel 1 (
    echo [ERROR] Failed to install the certificate.
    pause
    exit /b 1
)

echo [DONE] Root certificate installed for all users of this PC.
echo [DONE] Close and reopen the browser, then open https://devteam7:8082/
echo [DONE] Result can be checked with: trust-root-ca.bat /check
pause
exit /b 0

:check
echo [INFO] Certificates of Quality Control App in LocalMachine\Root:
certutil -store Root | findstr /I "BMZ devteam7"
echo.
echo [INFO] Same for the current user (CurrentUser\Root):
certutil -user -store Root | findstr /I "BMZ devteam7"
echo.
echo [INFO] "LocalMachine" lines above mean the certificate is installed for all users.
pause
exit /b 0
