# Database Configuration
DB_URL=jdbc:oracle:thin:@your-db-host:1521/plusora
DB_USERNAME=your_db_username
DB_PASSWORD=your_secure_db_password

# Security Configuration
JWT_SECRET=your_strong_jwt_secret_key_here
REMEMBER_ME_KEY=your_remember_me_secret_key_here

# ===== HTTPS / TLS =====
# Вариант 1 (как в проекте TAGS_SSL): .pfx-кейстор лежит рядом с jar.
# SSL_ENABLED=true
# SSL_STORE=file:devteam7keystore.pfx
# SSL_STORE_TYPE=PKCS12
# SSL_PASSWORD=<пароль от .pfx>
# SSL_KEY_PASSWORD=<пароль от .pfx>
# SSL_KEY_ALIAS=<alias ключа внутри .pfx>
#
# Вариант 2: кейстор в папке cert (совместимость со старыми именами переменных).
# SERVER_SSL_KEY_STORE=file:./cert/keystore.p12
# SERVER_SSL_KEY_STORE_PASSWORD=changeit
# SERVER_SSL_KEY_ALIAS=qualitycontrollapp
#
# Если ничего не задано — используется встроенный в jar кейстор
# classpath:keystore/keystore.p12 (пароль changeit, alias qualitycontrollapp).
#
# ===== Локальная разработка =====
# Скопируйте этот файл в .env, а локальные перекрытия держите в .env.local:
# он читается ПОСЛЕ .env, имеет приоритет и не копируется на сервер.
# Пример .env.local:
#   SSL_STORE=classpath:keystore/keystore.p12
#   SSL_PASSWORD=changeit
#   SSL_KEY_ALIAS=qualitycontrollapp
#
# Адрес и порт прослушивания (если SERVER_ADDRESS не задан — все интерфейсы):
# SERVER_ADDRESS=0.0.0.0
# SERVER_PORT=8082
