# Database Configuration
DB_URL=jdbc:oracle:thin:@your-db-host:1521/plusora
DB_USERNAME=your_db_username
DB_PASSWORD=your_secure_db_password

# Security Configuration
JWT_SECRET=your_strong_jwt_secret_key_here
REMEMBER_ME_KEY=your_remember_me_secret_key_here

# Права доступа: true - полный доступ всем вошедшим, false - роли из справочника персонала
APP_SECURITY_FULL_ACCESS=true

